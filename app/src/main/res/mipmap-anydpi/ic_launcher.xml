<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launcher icon for API 24/25 (Android 7.x).
     The adaptive-icon in mipmap-anydpi-v26 only exists for API 26+, so without
     this fallback @mipmap/ic_launcher would not resolve on Android 7 devices.
     On API 26+ the more specific -v26 adaptive icon is selected instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
