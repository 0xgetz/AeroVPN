<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include shared preferences for app settings -->
    <include
        domain="sharedpref"
        path="." />
    
    <!-- Include database for server lists and configs -->
    <include
        domain="database"
        path="." />
    
    <!-- Exclude sensitive data from backup -->
    <exclude
        domain="sharedpref"
        path="device_info.xml" />
    <!-- AUDIT FIX: aerovpn_prefs.xml holds the persisted last-VPN-config JSON
         (server credentials, private keys, passwords). Never back it up. -->
    <exclude
        domain="sharedpref"
        path="aerovpn_prefs.xml" />
    <!-- NOTE: no <include> covers the "file" domain, so files are never
         backed up anyway — the old <exclude domain="file" path="backup_key"/>
         was a no-op and failed lint (FullBackupContent). -->
</full-backup-content>
